---
import CustomerToolsCarousel from '../ui/CustomerToolsCarousel.jsx';

const tools = [
  {
    id: 'invoice',
    title: '2ª via da fatura',
    description: 'Consulte suas faturas e mantenha seus pagamentos em dia.',
    icon: 'invoice',
  },
  {
    id: 'support',
    title: 'Suporte técnico',
    description: 'Conte com a gente para resolver qualquer dificuldade.',
    icon: 'support',
  },
  {
    id: 'account',
    title: 'Minha conta',
    description: 'Acesse seus dados e gerencie os serviços contratados.',
    icon: 'account',
  },
];
---

<section
  id="customer-tools"
  aria-labelledby="customer-tools-title"
  class="w-full px-4 py-16 sm:px-6 sm:py-20"
>
  <div class="mx-auto w-full max-w-7xl">
    <header class="mb-10 text-center sm:mb-12">
      <h2 id="customer-tools-title" class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Que bom te ver de novo!
      </h2>
      <p class="mt-3 text-base text-neutral-600 sm:text-lg">
        Como podemos te ajudar hoje?
      </p>
    </header>

    <CustomerToolsCarousel client:visible tools={tools} />
  </div>
</section>