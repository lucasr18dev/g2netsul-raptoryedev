---
import type { HTMLAttributes } from 'astro/types';

// Tipagem das Props estendendo os atributos nativos de um <button>
interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string; // Se passar href, renderiza uma tag <a> estilizada como botão
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className,
  ...rest
} = Astro.props;

// Classes base (exemplo com Tailwind CSS ou CSS tradicional)
const baseStyles = "inline-flex items-center justify-center font-medium rounded-md transition-colors cursor-pointer focus:outline-none";

const variants = {
  primary: "font-roboto bg-bermuda text-white hover:bg-blue-700 active:bg-blue-800",
  secondary: "font-roboto bg-gray-800 text-white hover:bg-gray-900 active:bg-black",
  outline: "font-roboto border border-gray-300 text-gray-700 hover:bg-gray-100"
};

const sizes = {
  sm: "px-3 py-1.5 text-sm",
  md: "px-4 py-2 text-base",
  lg: "px-6 py-3 text-lg"
};

const buttonClasses = [
  baseStyles,
  variants[variant],
  sizes[size],
  className
].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={buttonClasses} {...rest as HTMLAttributes<'a'>}>
      <slot />
    </a>
  ) : (
    <button class={buttonClasses} {...rest}>
      <slot />
    </button>
  )
}