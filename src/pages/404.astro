---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Página não encontrada" description="Não encontramos essa página.">
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-6 text-center">
    <p class="text-sm font-bold uppercase tracking-widest text-blue-600">Erro 404</p>
    <h1 class="mt-3 text-4xl font-bold">Página não encontrada</h1>
    <p class="mt-4 text-neutral-600">O endereço pode estar incorreto ou a página foi movida.</p>
    <a href="/" class="mt-8 rounded-md bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-700">
      Voltar para o início
    </a>
  </section>
</MainLayout>